;; A tiny environment for the test of a dedicated compiler: a prelude
;; that needs a flag of the C compiler, and a table with its functions.
```:prelude
#ifndef ENVT_BASE
#error "the flags of the environment are missing"
#endif
#ifdef ATM_CLOCK_MS
#error "envt: ATMOS_CLOCK=ms is not supported"
#endif
```
pin envt = []
func envt.add (n) {
    `:number ENVT_BASE` + n
}

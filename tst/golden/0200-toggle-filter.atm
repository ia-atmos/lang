        pin T = task () {
            spawn (task () {
                loop on :Draw { print(:draw) }
            }) ()
            loop on :Tick { print(:tick) }
        }
        pin t = spawn T()
        emit(:Draw)                 ;; on  -> draw
        emit(:Tick)                 ;; on  -> tick
        mute <!:Draw> t(true) ;; muted, but :Draw passes
        emit(:Draw)                 ;; passes filter -> draw
        emit(:Tick)                 ;; gated -> frozen
        mute t (false)
        emit(:Tick)                 ;; on  -> tick
    
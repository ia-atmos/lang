        spawn {
            mute <!:Draw> on :Show {
                par {
                    loop on :Draw { print(:draw) }
                } with {
                    loop on :Tick { print(:tick) }
                }
            }
        }
        emit(:Draw)             ;; on  -> draw
        emit(:Tick)             ;; on  -> tick
        emit :Show [true]     ;; muted, :Draw passes
        emit(:Draw)             ;; passes filter -> draw
        emit(:Tick)             ;; gated -> frozen
        emit :Show [false]      ;; unmuted
        emit(:Tick)             ;; on  -> tick
    
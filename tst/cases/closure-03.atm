val fs = []
;; a captured variable belongs to its block, and leaves it with the
;; closure that is the result of the block
loop i in 3 {
    set fs@+ = do {
        var k = i * 10
        func () { set k = k + 1 ; (i, k) }
    }
}
;; but the closure cannot be stored outside the block by itself
loop i in 1 {
    var k = i
    print(catch true { set fs@+ = func () { set k = k + 1 } })
}
print(fs@0(), fs@1(), fs@2())
print(fs@0())
val add = \x { \y { \z { x + (y + z) } } }
print(add(1)(2)(3))
val t = [10]
val g = \{ set t@0 = t@0 + it ; t@0 }
print(g(1), g(2))

;; A task that nobody pinned, but that is still referred to (here, by a
;; fresh table that is the parameter of another task), ends with the
;; outermost block of the task that spawned it, after its defers, and
;; that task only terminates after it: also when the orphan is the one
;; that is running.
task O (id, late) {
    defer { print(id, "defer orphan") }
    await(:X)
    if late { emit @:global (:Y) }
    print(id, "never")
    await(false)
}
task K (keep) {
    await(false)
}
func start (id, late) {
    spawn O(id, late)
}
task U (id, late) {
    defer { print(id, "defer U") }
    spawn K([start(id, late)])
    await(:Y)
    print(id, "U ends")
}
print("-- orphan suspended")
pin a = spawn U(:A, false)
emit(:Y)
print(atmos.status(a))
print("-- orphan running")
pin b = spawn U(:B, true)
spawn {
    await(b)
    print("B terminated")
}
emit(:X)
print(atmos.status(b))

;; one that nobody refers to is aborted at once
start(:M, false)
defer { print("defer main") }
print("-- end")

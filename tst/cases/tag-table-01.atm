pin AREA = []                               ;; tag -> function
set AREA.Circle = func (s) { 3 * s.r * s.r }
set AREA.Rect   = func (s) { s.w * s.h }

func area (s) {
    AREA@(s.tag)(s)                         ;; chooses by the tag
}

print(area(:Circle [r=1]))                  ;; --> 3
print(area(:Rect [w=2, h=3]))               ;; --> 6

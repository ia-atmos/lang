;; a range with a step: (a, b, s)
loop i in (0, 10, 5) { print(i) }
loop y in (3, 1, -1) { print(y) }
loop x in (0.0, 1.0, 0.25) { print(x) }
loop i in (5, 0, 2) { print(:never) }
loop i in (3, 1) { print(:never) }
print(catch true { loop i in (0, 3, 0) { } })
print(catch true { loop i in (0, 3, "x") { } })
print(iter.sum(0, 10, 5), iter.any((10, 0, -5), \{ it == 5 }))
X.print(iter.map((0, 1, 0.5), \{ it * 2 }))
print(iter.fold(1, 3, 0, \(acc, v) { acc + v }))

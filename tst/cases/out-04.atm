;; The same place written with `set :out` many times to the same value
;; has one entry; two places of the same value both go back to nil when
;; it ends; a place that meanwhile refers to another value keeps it.
pin G = [x=nil, y=nil, z=nil]
task T (o) { set :out G.x = o }
do {
    pin obj = [v=1]
    pin oth = [v=2]
    loop in 1000 { spawn T(obj) }
    set :out G.y = obj
    set :out G.z = obj
    set G.z = 10
    print(G.x.v, G.y.v, G.z)
}
print(G.x, G.y, G.z)

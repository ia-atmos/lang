;; #3: the grab block and all it holds receive: a pool declared inside
;; it does; a pool declared outside it, in the grabbable, does not
task T (s) {
    loop on :key {
        print(s)
    }
}
spawn {
    grabbable true {
        pin outs = tasks()
        spawn @outs T("out")
        grab :key {
            pin ins = tasks()
            spawn @ins T("in")
            spawn T("nested")
            await :key
            print("block")
        }
        print("released")
        await(false)
    }
}
emit :key
emit :key

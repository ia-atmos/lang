;; A deep pin adopts the unpinned values with no name. One with a name is
;; only referenced when the holder is inside the block of the name (the
;; name keeps seeing it), and adopted when the holder is in that block or
;; outside (see deep-07)
task Item (r) {
    spawn {
        pin over = \(x, y) { r.x + x + y }
        print(:over, over(1, 2))
    }
    print(:item, r.x)
}
pin it = spawn Item([x=10])

;; the same for a store into a pinned table
pin h = []
do {
    val k = [1]
    set h.k = k
    print(:k, h.k == k)
}
print(:h, h.k@0)

;; an unnamed value is adopted with its holder
do {
    pin t = [[2]]
    print(:t, t@0@0)
}

;; a named value that a holder outside adopted may not be pinned again
pin h2 = []
do {
    val k = [3]
    set h2.k = k
    pin z = k
}

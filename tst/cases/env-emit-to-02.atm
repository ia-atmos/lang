;; atm_emit_to: the target ends normally, which awakes its parent,
;; outside the traversal; the exit that the parent raises reaches the
;; trail that awaits it, as with a broadcast (reported by env-uv)
```:prelude
static struct ATask* WHO = NULL;
static int TO = 1;
static void wake (void) {
    if (WHO != NULL) {
        struct ATask* w = WHO;
        WHO = NULL;
        AVal x = a_strz("x");
        if (TO) {
            atm_emit_to(a_obj(&w->node.hdr), x);
        } else {
            atm_emit(x);
        }
        a_dec(x);
    }
}
```

task Inner () {
    `WHO = a_cur;`
    await :x
}
task Outer () {
    await Inner()
    throw :E
}

atmos.env([
    mode = [primary=true],
    step = func (mode) {
        `wake();`
    },
])

val ok = catch :E {
    await Outer()
}
print("caught", ok)

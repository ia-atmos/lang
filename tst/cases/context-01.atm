;; #1 (the author, 2026-11-22): enter and leave run around each
;; resume of a trail inside, with a lazy switch
spawn {
    context {
        :enter { print "+A" }
        :leave { print "-A" }
        loop on :draw { print "a" }
    }
}
spawn {
    loop on :draw { print "b" }
}
print "draw"
emit :draw
print "key"
emit :key
print "end"

;; find over a pool and over a table: the member and its key, or nil.
task P (x) {
    set pub = [x=x]
    await(false)
}
pin ts = tasks()
spawn @ts P(10)
spawn @ts P(20)
spawn @ts P(30)
val t, i = iter.find(ts, \(t) { t.pub.x > 15 })
print(t.pub.x, i)                               ;; 20 1
print(iter.find(ts, \(t) { t.pub.x > 99 }))          ;; nil
print(iter.find(tasks(), \(t) { true }))             ;; nil
print(iter.find([10,20,30], \(v) { v > 15 }))        ;; 20 1
print(iter.find([a=1,b=2], \(v,k) { k == :b }))      ;; 2 b
print(iter.find([], \(v) { true }))                  ;; nil
pin es = [[hp=3], [hp=0], [hp=5]]
val e = iter.find(es, \(e) { e.hp == 0 })
set e.hp = 1
print((es@1).hp)                                ;; 1

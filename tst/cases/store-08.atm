;; an unpinned task that is dropped is aborted at once; one that is still
;; referred to, and confined to a block, ends with the block
task T (id, v) {
    defer { print(:dead, id, v@0) }
    await(:X)
    print(:awake, id, v@0)
    await(false)
}
func sp (id, v) {
    spawn T(id, v)
}
do {
    pin a = [1]
    ;; dropped
    sp(:a, a)
    ;; rejected
    ;; named: aborted at the end of the block of the name
    print(catch true { val x = sp(:b, a) })
    do {
        pin b = [2]
        sp(:c, b)
        ;; returned, but it cannot leave
        print(catch true {
            pin y = do {
                pin c = [3]
                sp(:d, c)
            }
        })
        emit(:X)
        print(:1)
    }
    print(:2)
    emit(:X)
    print(:3)
}
print(:4)
;; with no pinned argument either
sp(:e, [5])
;; one that is still referred to, by an unpinned table that is the
;; parameter of another task: it ends with the block of the values it
;; is confined to
task K (keep) {
    await(false)
}
do {
    pin f = [6]
    spawn K([sp(:f, f)])
    emit(:X)
    print(:6)
}
emit(:X)
print(:5)

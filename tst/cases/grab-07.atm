;; #7: an emit that does not traverse the grabbable is not captured:
;; one aimed at a task below it, outside the grab
task T () {
    par {
        loop on :key {
            print("T key")
        }
    } with {
        loop on :ping {
            print("T ping")
        }
    }
}
spawn {
    grabbable true {
        pin t = spawn T()
        grab :key, :ping {
            loop on :key {
                print("modal")
                emit @t :ping       ;; from the task t down: not captured
            }
        }
    }
}
emit :key                           ;; through the grabbable: captured

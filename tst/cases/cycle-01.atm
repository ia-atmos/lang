;; Without a pin, reference counting applies: a cycle of unpinned values
;; leaks. A cyclic structure is pinned, and is finalized at the end of
;; the block of its pin, deeply. (The tests run with the address
;; sanitizer, which reports a cycle that leaks.)

do {                            ;; reached only by its name
    pin a = []
    set a.self = a
}

loop i in 100 {                 ;; a table and a closure
    pin a = [i]
    set a.f = func () { a }
}

do {                            ;; a recursive closure, through its box
    pin var g
    set g = func (n) { if n > 0 { g(n - 1) } else { :done } }
    print(g(3))
}

pin out = []
do {                            ;; held by a pinned table of an outer block
    val a = [v=10]
    set a.self = a
    set out.x = a
}
print(out.x.self.v)

func mk () {                    ;; built by a function, pinned by the caller
    val b = [v=30]
    val a = [b=b]
    set b.a = a
    b
}
pin m = mk()
print(m.a.b.v)

task T (t) {
    await(:go)
    print(t.self.v)
}
do {                            ;; given to a task of the same block
    pin a = [v=50]
    pin ts = tasks()
    set a.self = a
    spawn @ts T(a)
    emit(:go)
}

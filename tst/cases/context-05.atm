;; #1: nested contexts; a task spawned inside into a pool outside runs outside
pin ts = tasks()
task T () {
    loop on :draw { print "t" }
}
spawn {
    context {
        :enter { print "+A" }
        :leave { print "-A" }
        context {
            :enter { print "+B" }
            :leave { print "-B" }
            spawn @ts T()
            loop on :draw { print "b" }
        }
    }
}
print "draw"
emit :draw

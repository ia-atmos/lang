;; set :out pub = v: the pub of the running task refers to a value of an
;; inner block, until the value ends: then it goes back to nil. An
;; unpinned value stays until the block of the set ends.
task T () {
    do {
        pin x = [v=10]
        set :out pub = x
        await(:a)
    }                               ;; x ends: pub is nil
    await(:b)
    set :out pub = [v=20]
    await(:c)
}
pin t = spawn T()
print(t.pub.v)
emit(:a)
print(t.pub)
emit(:b)
print(t.pub.v)
emit(:c)
print(t.pub)

;; a value that outlives the task: the place goes with the task
task U (z) {
    set :out pub = z
    await(:d)
}
do {
    pin y = [v=30]
    do {
        pin u = spawn U(y)
        print(u.pub.v)
    }
    print(y.v)
}
print(:end)

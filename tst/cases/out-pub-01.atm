;; The pub ends with its task. Written by the task, it may hold what is
;; pinned in the body block of the task, with a plain set; data of an
;; inner block is an escape. The pub may also refer to another task, with
;; set :out. A name that kept data read through a pub refers to a dead
;; value after the task ends.
task Widget () {
    set pub = []
    pin spring = [k=10]
    set pub.spring = spring         ;; ok: both end with the task
    do {
        pin inner = [k=20]
        print(catch true { set pub.inner = inner })
        pin sub = spawn { await false }
        set :out pub.sub = sub      ;; a task of an inner block
        print(type(pub.sub))
    }
    print(type(pub.sub))
    await :end
}
pin w = spawn Widget()
val s = w.pub.spring                ;; a name of data of the task
print(s.k, type(s), type(w.pub))
emit :end
print(type(w), type(s))
print(catch true { s.k })
print(catch true { w.pub })

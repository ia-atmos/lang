;; #3 (the author, 2026-11-22): leave receives what enter returned
var layer = :world
func set_layer (l) {
    val old = layer
    set layer = l
    old
}
spawn {
    context {
        :enter { set_layer(:panel) }
        :leave \(old) { set_layer(old) }
        loop on :draw { print("panel", layer) }
    }
}
spawn {
    loop on :draw { print("other", layer) }
}
emit :draw
print("end", layer)

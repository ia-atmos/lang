;; transfer of tables on exits
func mk (n) {
    val t = [n]
    val u = [t, x=t]
    set t.up = u
    u
}
func chk (v) {
    print(v@0@0, v.x == v@0, v.x.up == v)
}
pin a = mk(1)
chk(a)
;; unpinned: pinned where it arrives, with what it holds
pin box = [a]
print(#box)
set a.x.up = nil

;; block value, and pinned again
pin b = do {
    val t = [2]
    t
}
print(b@0)
print(catch true { set box@+ = b })

;; return, break, escape
func ret () {
    do {
        val t = [3]
        return(t)
    }
}
pin c = ret()
set box@+ = c
pin d = loop {
    val t = [4]
    break(t)
}
set box@+ = d
pin e = do :X {
    do {
        val t = [5]
        escape(:X, t)
    }
}
set box@+ = e
print(#box, box@1@0, box@2@0, box@3@0)

;; multiple values
func two () {
    val x = [6]
    val y = [7]
    (x, y)
}
pin p, q = two()
set box@+ = p
set box@+ = q
print(#box, p@0, q@0)

;; alias: pinned outside the block
pin k = [8]
val r = do {
    pin z = [9]
    set z.k = k
    k
}
print(r == k, catch true { set box@+ = r })
;; a value of the block that holds one pinned outside
pin s = do {
    val z = [10, k=k]
    z
}
print(s@0, s.k == k, catch true { set box@+ = s })
;; and it may be pinned again, in a block inside
do {
    pin w = do {
        val z = [11, k=k]
        z
    }
    print(w@0, w.k == k)
}
print(#k, #box)

;; a pinned value never leaves its block, not even as its result
print(catch true {
    val x = do {
        pin t = [12]
        t
    }
})
func pinned () {
    pin t = [13]
    return(t)
}
print(catch true { pinned() })
print(catch true {
    val x = do {
        pin t = [14]
        [t]
    }
})

;; #4 (the author, 2026-11-22): `in X, do {...}`, X is :Context [enter=f, leave=g] (#23)
var layer = :world
func in_layer (l) {
    :Context [enter=\{ val o = layer ; set layer = l ; o }, leave=\(o) { set layer = o }]
}
spawn {
    in in_layer(:panel), do {
        loop on :draw { print("a", layer) }
    }
}
spawn {
    val p = in_layer(:menu)
    in p, do {
        loop on :draw { print("b", layer) }
    }
}
spawn {
    loop on :draw { print("c", layer) }
}
emit :draw
print("end", layer)

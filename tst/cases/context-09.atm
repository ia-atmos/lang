;; #5: an error in enter is raised at the await of the trail it resumes
var X = false
spawn {
    catch :E {
        context {
            :enter { if X { throw(:E) } }
            :leave { nil }
            loop on :draw { print "draw" }
        }
    }
    print "caught"
}
emit :draw
set X = true
emit :draw
print "end"

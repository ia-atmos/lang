;; #1: a grab takes the nearest grabbable in the tree of tasks: here,
;; the modal is a task spawned deep inside what it silences (SNKRX)
task Modal () {
    grab :key {
        loop e on :key {
            print("modal", e@0)
            until e@0 == :esc
        }
    }
}
task Screen () {
    par {
        loop e on :key {
            print("screen", e@0)
        }
    } with {
        loop {
            await :key [:esc]
            await Modal()
        }
    }
}
spawn {
    grabbable true {
        await Screen()
    }
}
spawn {
    loop e on :key {
        print("outside", e@0)     ;; outside the grabbable: always hears
    }
}
emit :key [:a]
emit :key [:esc]
emit :key [:b]
emit :key [:esc]
emit :key [:c]

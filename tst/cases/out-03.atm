;; Who refers to a task through a place of `set :out` may test its state,
;; or wait for its end, instead of finding a nil.
task Enemy (name) {
    set pub = [name=name, hp=10]
    await :die
}
pin hud = [enemy=nil]
spawn {
    await :focus
    watching hud.enemy {
        loop {
            await :tick
            print("hud", hud.enemy.pub.name, hud.enemy.pub.hp)
        }
    }
    print("hud", "gone", hud.enemy ?? :xtask.dead)
}
do {
    pin e = spawn Enemy("goblin")
    set :out hud.enemy = e
    emit :focus
    emit :tick
    set e.pub.hp = 5
    emit :tick
    emit :die
    emit :tick
}
if hud.enemy && !(hud.enemy ?? :xtask.dead) {
    print("alive")
} else {
    print("dead")
}

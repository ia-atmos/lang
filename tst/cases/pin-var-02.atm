;; A `pin var` with no initial value owns what it gets later: it is
;; finalized at the end of its block. Here, a function that refers to its
;; own variable: a cycle, which would leak if the block did not end it.
do {
    pin var g
    set g = func (n) { if n > 0 { g(n - 1) } else { :ok } }
    print(g(2))
}

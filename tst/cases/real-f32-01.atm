;; reals of 32 bits (ATMOS_REAL=float): each operation rounds to float
var vy = 0.0
val dt = 1.0/(1000.0/15.0)
loop _ in 3 {
    set vy = vy + (10*100)*dt
    print(vy, string.format("%.9g", vy))
}
print(0.1, 0.1+0.2, 1/3, 2.5, 1e10, 16777217.0, 3 + 0.5, 7 // 2.0, 7.5 % 2)
print(math.sqrt(2), math.pi, math.floor(2.7), math.abs(-0.1), math.huge)
print(tonumber("0.1"), 0.1 == tonumber("0.1"), 1 == 1.0, 0.5 < 1, 2 > 1.5)
val t = []
set t@(0.5) = 'a'
set t@(2.0) = 'b'
print(t@(0.5), t@2, 9007199254740993 + 0, 1e100)

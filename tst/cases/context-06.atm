;; #2 (by the session, to be confirmed): no filter: any event that awakes a
;; task inside switches, and an event that awakes nothing inside does not
spawn {
    context (\{ print "+A" }, \{ print "-A" }) {
        par {
            loop on :draw { print "draw" }
        } with {
            loop on :key { print "key" }
        }
    }
}
emit :tick
print "tick"
emit :key
emit :draw
print "end"

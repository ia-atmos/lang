;; #2 (the author, 2026-11-22): no filter: any event that awakes a
;; task inside switches, and an event that awakes nothing inside does not
spawn {
    context {
        enter { print "+A" }
        leave { print "-A" }
        par {
            loop on :draw { print "draw" }
        } with {
            loop on :key { print "key" }
        }
    }
}
emit :tick
print "tick"
emit :key
emit :draw
print "end"

spawn {
    val ok1, r = watching :X {
        par :any {
            await(:Y)
            :inner_y
        } with {
            await(:Z)
            :inner_z
        }
    }
    print(ok1, r)
    val ok2, s = watching :X {
        await(:W)
        :body
    }
    print(ok2)
    X.print(s)
}
emit(:Z)
emit(:X [1])

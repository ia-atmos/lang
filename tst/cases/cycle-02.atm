;; A cyclic value that a call returns and that is dropped with no name:
;; the temporary that held it breaks the cycle.
func mk () {
    val b = [v=30]
    val a = [b=b]
    set b.a = a
    b
}
print(mk().a.b.v)               ;; read through, and dropped
mk()                            ;; dropped at once
val n = #[mk(), mk()]           ;; held by a table that is dropped
print(n)
func id (x) { x }
print(id(mk()).v)               ;; through a parameter

;; A cyclic value that is given to a task of a pool of an outer block:
;; it is reached when the task ends.
task T (t) {
    await(:go)
    print(t.self.v)
}
pin ts = tasks()
do {
    val a = [v=50]
    set a.self = a
    spawn @ts T(a)
}
emit(:go)
print(:end)

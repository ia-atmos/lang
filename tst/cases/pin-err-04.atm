;; a named value stored into a pinned table of an inner block is only
;; referenced: the name still sees it after that block
func f (o) {
    do {
        pin h = []
        set h.x = o
    }
    print(o@0)
}
f([7])

;; and it may no longer be pinned inside the block of the table
pin h = []
do {
    val k = [1]
    set h.k = k
    pin z = k
}

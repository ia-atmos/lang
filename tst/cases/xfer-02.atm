;; transfer of closures and tasks
func counter () {
    val st = [n=0]
    func () {
        set st.n += 1
        st.n
    }
}
pin f = counter()
pin fs = [f]
print(f(), f(), fs@0())

task T (v) {
    defer { print(:dead, v) }
    await(:X)
    print(:awake, v)
}
func sp (v) {
    val t = spawn T(v)
    t
}
;; a name holds it, and it is aborted at the end of the block of the name
print(catch true { val x = sp(:a) })
print(:1)
do {
    pin x = sp(:b)
    print(:2)
    emit(:X)
}
print(:3)
func pool () {
    val ts = tasks()
    spawn @ts T(:c)
    spawn @ts T(:d)
    ts
}
do {
    pin ts = pool()
    print(#ts)
}
print(:4)
;; a task is confined to its pinned arguments
func bad () {
    pin a = [1]
    val t = spawn T(a@0)
    val u = spawn (task (v) { await(false) }) (a)
    (t, u)
}
print(catch true { pin t = bad() })
func bad2 () {
    pin a = [1]
    pin U = task () { await(false) ; a }
    val u = spawn U()
    u
}
print(catch true { pin t = bad2() })
;; unless it has terminated
func done () {
    pin a = [1]
    pin U = task () { a@0 }
    spawn U()
}
pin dn = done()
print(type(dn))
print(:5)
;; tasks held by data leave with it, and are pinned with it again
func held () {
    val t = spawn T(:e)
    val r = [t]
    r
}
do {
    pin h = held()
    print(#h, type(h@0))
}
print(:6)
;; but not a task of a pool that stays
func held2 () {
    pin ts = tasks()
    val r = [spawn @ts T(:f)]
    r
}
print(catch true { pin h = held2() })
;; unless the pool leaves too
func held3 () {
    val ts = tasks()
    val r = [ts, spawn @ts T(:g)]
    r
}
do {
    pin h = held3()
    print(#h@0, type(h@1))
}
print(:7)
;; a pool held by data
func held4 () {
    val r = [ts=tasks()]
    spawn @(r.ts) T(:h)
    r
}
do {
    pin h = held4()
    print(#h.ts)
}
print(:8)

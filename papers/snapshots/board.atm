;; The example of the paper on snapshots (`papers/snapshots.md`, Section 3).
;;
;; Notes on a board. The snapshot `S` is a table of data. Only commands
;; (`:cmd.*`) change it, through `apply`. A note is a disposable task: it
;; reads its row of `S`, holds a drag in progress in its locals, and on the
;; drop emits `:cmd.move`. The journal holds the commands, and a snapshot
;; is written every few commands.
;;
;; The input is a script (`INPUT`), as in the test modes of the ports.
;; After the run, the program checks the claims of the paper:
;;   resume  : the last snapshot plus the commands after it give `S`
;;   instant : any instant is the nearest snapshot plus the commands to it
;;   spawn   : the tasks spawned by commands are those spawned from `S`
;;   hidden  : a restart between two inputs does not change the future
;;
;; Run: `atmos papers/snapshots/board.atm`, or `papers/snapshots/test.sh`.

;; --- The snapshot and the commands ---------------------------------------

val EMPTY = "[seq=0, next=1, notes=[]]"
val EVERY = 3                       ;; a snapshot every 3 commands

;; The applier: a function of the table and the command (rules R2, R3).
;; A command that does not apply is rejected, and writes nothing (R8).
func apply (S, c) {
    match c {
        :cmd.add => {
            val id = S.next
            set S.next = id + 1
            set S.notes@(id) = [x=c.x, y=c.y]
            true
        }
        :cmd.move => {
            val n = S.notes@(c.id)
            if n == nil => false => do {
                set n.x = c.x
                set n.y = c.y
                true
            }
        }
        :cmd.del => {
            if S.notes@(c.id) == nil => false => do {
                set S.notes@(c.id) = nil
                true
            }
        }
        else => false
    }
}

;; --- The disposable tasks -------------------------------------------------

func inside (n, e) {
    math.abs(n.x - e.x) <= 2 && math.abs(n.y - e.y) <= 2
}

;; A note lives while its row does. The drag in progress is in `p`, a local
;; of the task, and is lost on a restart: it is disposable by design.
;; With `HIDDEN`, the note also counts its drags in a local and shifts each
;; drop by that count: state that outlives a command and affects the next
;; one (against rule R4), which the test "hidden" must detect.
var HIDDEN = false

task Note (S, id) {
    set pub = id
    var drags = 0
    watching :applied until S.notes@(id) == nil {
        loop {
            await :mouse.down until inside(S.notes@(id), it)
            var p = nil
            watching :mouse.up {
                loop m on :mouse.move {
                    set p = m
                }
            }
            if p {
                val dx = if HIDDEN => drags => 0
                set drags = drags + 1
                emit @:global :cmd.move [id=id, x=p.x+dx, y=p.y]
            }
        }
    }
}

;; The board spawns one note per row, in the order of the ids, and one more
;; for each `:cmd.add` (rule R6: both paths must give the same tasks).
task Board (S) {
    pin ts = tasks()
    loop id in (1, S.next - 1) {
        if S.notes@(id) {
            spawn @ts Note(S, id)
        }
    }
    spawn {
        loop on :key.a {
            val e = await :mouse.down
            emit @:global :cmd.add [x=e.x, y=e.y]
        }
    }
    spawn {
        loop on :key.d {
            val e = await :mouse.down
            loop _,t in ts {
                if inside(S.notes@(t.pub), e) {
                    emit @:global :cmd.del [id=t.pub]
                    break()
                }
            }
        }
    }
    spawn {
        loop q on :ask {                ;; for the test: which notes live
            loop _,t in ts {
                set q.ids@+ = t.pub
            }
        }
    }
    loop a on :applied {
        if a.cmd ?? :cmd.add {
            spawn @ts Note(S, S.next - 1)
        }
    }
}

;; --- The program ------------------------------------------------------------

pin var S       = X.load(EMPTY)
pin var journal = []                ;; the commands, as data
pin var snaps   = []                ;; [seq, text of S], every EVERY commands
pin var hist    = []                ;; for the test: S after each command

;; The only writer of `S` (R2). Only commands from outside are recorded (R7).
spawn {
    loop c on :cmd {
        if apply(S, c) {
            set S.seq = S.seq + 1
            set journal@+ = X.dump(c)
            set hist@+ = X.dump(S)
            if S.seq % EVERY == 0 {
                set snaps@+ = [seq=S.seq, s=X.dump(S)]
            }
            emit @:global :applied [cmd=c]
        }
    }
}

pin boards = tasks(1)

;; A restart: abort the disposable part, replace the table, spawn again.
func restart (text) {
    loop _,b in boards {
        abort b
    }
    set S = X.load(text)
    spawn @boards Board(S)
}

;; A new run, from the empty board.
func fresh () {
    set journal = []
    set snaps   = [[seq=0, s=EMPTY]]
    set hist    = [EMPTY]
    restart(EMPTY)
}

;; Replay: a snapshot, then the commands of the journal from `i` to `j - 1`,
;; through the applier alone: no task is spawned.
func replay (text, i, j) {
    val T = X.load(text)
    loop k in (i, j - 1) {
        if apply(T, X.load(journal@(k))) {
            set T.seq = T.seq + 1
        }
    }
    X.dump(T)
}

;; The ids of the notes alive, in order: what rule R6 compares.
func alive () {
    val q = :ask [ids=[]]
    emit(q)
    X.dump(q.ids)
}

;; --- The input ------------------------------------------------------------

;; `:cut` marks a point between two gestures, where the test "hidden" may
;; restart; a normal run ignores it.
val INPUT = [
    :key.a [], :mouse.down [x=10, y=10],            ;; add note 1
    :cut [],
    :key.a [], :mouse.down [x=20, y=10],            ;; add note 2
    :cut [],
    :key.a [], :mouse.down [x=30, y=10],            ;; add note 3
    :cut [],
    :mouse.down [x=20, y=10],                       ;; drag note 2
        :mouse.move [x=21, y=12], :mouse.move [x=25, y=15],
        :mouse.up [],
    :cut [],
    :key.d [], :mouse.down [x=10, y=10],            ;; delete note 1
    :cut [],
    :mouse.down [x=30, y=10],                       ;; drag note 3
        :mouse.move [x=30, y=20],
        :mouse.up [],
    :cut [],
    :mouse.down [x=10, y=10],                       ;; nothing there now
        :mouse.move [x=11, y=11],
        :mouse.up [],
    :cut [],
    :key.a [], :mouse.down [x=40, y=40],            ;; add note 4
    :cut [],
    :mouse.down [x=25, y=15],                       ;; drag note 2 again
        :mouse.move [x=50, y=50],
        :mouse.up [],
    :cut [],
    :mouse.down [x=50, y=50],                       ;; and once more
        :mouse.move [x=60, y=60],
        :mouse.up [],
]

;; Runs the input; with `cuts`, restarts from a dump of `S` at each `:cut`.
func run (cuts) {
    fresh()
    loop _,e in INPUT {
        if e ?? :cut {
            if cuts {
                restart(X.dump(S))
            }
        } else {
            emit(e)
        }
    }
    X.dump(S)
}

func check (name, ok) {
    print(name, if ok => "ok" => "FAILED")
}

;; --- The checks of the paper -------------------------------------------------

val final = run(false)
print("final", final)
print("journal", #journal, "snapshots", #snaps)

;; resume: the last snapshot, plus the commands after it.
val last = snaps@#
check("resume", replay(last.s, last.seq, #journal) == final)

;; instant: every instant, from the nearest snapshot before it.
var all = true
loop k in (0, #journal) {
    var near = snaps@0
    loop _,sn in snaps {
        if sn.seq <= k {
            set near = sn
        }
    }
    if replay(near.s, near.seq, k) != hist@(k) {
        set all = false
    }
}
check("instant", all)

;; spawn (R6): the notes spawned along the run are those spawned from `S`.
val before = alive()
restart(X.dump(S))
check("spawn", alive() == before)
print("alive", before)

;; hidden (R4): restarts between gestures do not change the future.
check("hidden", run(true) == final)

;; The same test finds the state that a note keeps in a local.
set HIDDEN = true
val f1 = run(false)
val f2 = run(true)
print("hidden state detected", f1 != f2)

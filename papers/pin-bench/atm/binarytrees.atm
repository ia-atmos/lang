;; binary-trees (CLBG), from the Lua version of dyn-lex-benchmark

func bottomUp (d) {
    if d > 0 {
        [bottomUp(d-1), bottomUp(d-1)]
    } else {
        [false, false]
    }
}

func check (t) {
    if t@0 {
        1 + check(t@0) + check(t@1)
    } else {
        1
    }
}

val N = tonumber(...) || 10
val mindepth = 4
val maxdepth = math.max(mindepth+2, N)

do {
    val d = maxdepth + 1
    val t = bottomUp(d)
    print(string.format("stretch tree of depth %d\t check: %d", d, check(t)))
}

pin longlived = bottomUp(maxdepth)

loop i in (0, (maxdepth-mindepth)//2) {
    val depth = mindepth + 2*i
    val iters = 1 << (maxdepth - depth + mindepth)
    var chk = 0
    loop in iters {
        val t = bottomUp(depth)
        set chk = chk + check(t)
    }
    print(string.format("%d\t trees of depth %d\t check: %d", iters, depth, chk))
}

print(string.format("long lived tree of depth %d\t check: %d", maxdepth, check(longlived)))

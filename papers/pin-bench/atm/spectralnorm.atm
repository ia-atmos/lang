;; spectral-norm (CLBG), as the C version
func A (i, j) {
    val ij = i + j
    1.0 / ((ij*(ij+1))//2 + i + 1)
}
func Av (n, v, o) {
    loop i in n {
        var s = 0.0
        loop j in n {
            set s = s + A(i,j)*v@j
        }
        set o@i = s
    }
}
func Atv (n, v, o) {
    loop i in n {
        var s = 0.0
        loop j in n {
            set s = s + A(j,i)*v@j
        }
        set o@i = s
    }
}
func AtAv (n, v, o, t) {
    Av(n, v, t)
    Atv(n, t, o)
}
val n = tonumber(...) || 100
pin u = []
pin v = []
pin t = []
loop in n {
    set u@+ = 1.0
    set v@+ = 0.0
    set t@+ = 0.0
}
loop in 10 {
    AtAv(n, u, v, t)
    AtAv(n, v, u, t)
}
var vBv = 0.0
var vv = 0.0
loop i in n {
    set vBv = vBv + u@i*v@i
    set vv = vv + v@i*v@i
}
print(string.format("%.9f", math.sqrt(vBv/vv)))

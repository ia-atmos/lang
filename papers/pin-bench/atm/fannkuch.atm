;; fannkuch-redux (CLBG), as the C version
val n = tonumber(...) || 7
pin perm  = []
pin perm1 = []
pin count = []
loop i in n {
    set perm@+  = 0
    set perm1@+ = i
    set count@+ = 0
}
var r = n
var maxflips = 0
var checksum = 0
var permcount = 0
loop {
    loop {
        while r != 1
        set count@(r-1) = r
        set r = r - 1
    }
    loop i in n {
        set perm@i = perm1@i
    }
    var flips = 0
    var k = perm@0
    loop {
        while k != 0
        var i = 0
        var j = k
        loop {
            while i < j
            val t = perm@i
            set perm@i = perm@j
            set perm@j = t
            set i = i + 1
            set j = j - 1
        }
        set flips = flips + 1
        set k = perm@0
    }
    if flips > maxflips {
        set maxflips = flips
    }
    if permcount % 2 == 0 {
        set checksum = checksum + flips
    } else {
        set checksum = checksum - flips
    }
    val done = loop {
        until r == n, true
        val p0 = perm1@0
        loop i in r {
            set perm1@i = perm1@(i+1)
        }
        set perm1@r = p0
        set count@r = count@r - 1
        if count@r > 0 {
            break(false)
        }
        set r = r + 1
    }
    until done
    set permcount = permcount + 1
}
print(checksum)
print(string.format("Pfannkuchen(%d) = %d", n, maxflips))

;; Example 5: a pool of tasks pinned outside a loop
task Conn (id) {
    defer {
        print("closed", id)
    }
    await :never
}
do {
    pin conns = tasks()
    loop i in 3 {
        spawn @conns Conn(i)        ;; each task lives in the pool, not in the loop body
    }
    print("open", #conns)
}                                   ;; the pool and its tasks end here
